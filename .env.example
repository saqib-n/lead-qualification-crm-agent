# LLM provider, pick one and fill in its key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# "<provider>:<model>", e.g. openai:gpt-5.5, anthropic:claude-opus-5-5 or google_genai:gemini-3.5-flash
LLM_MODEL=openai:gpt-5.5

# Optional, pushes qualified leads to a real HubSpot account instead of
# output/crm_leads.csv. Private app token with the crm.objects.contacts.read
# and crm.objects.contacts.write scopes.
HUBSPOT_ACCESS_TOKEN=

# Optional, posts a Slack message for every qualified lead
SLACK_WEBHOOK_URL=
